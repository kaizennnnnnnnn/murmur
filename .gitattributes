# Normalise line endings so the repo does not depend on one machine's git config.
* text=auto eol=lf

# Windows refuses to run some .bat files reliably with bare LF, and cscript is
# likewise happier with CRLF, so these two keep native endings on checkout.
*.bat text eol=crlf
*.vbs text eol=crlf

# Never touch binaries.
*.ico binary
*.png binary
*.jpg binary
*.webp binary
*.wav binary
